---
import { Image } from 'astro:assets';
import { getEvents, urlFor } from '../utils/sanity';
import CarouselButton from './CarouselButton.astro';
import 'swiper/css';

const allEvents = await getEvents();
const now = new Date();

const upcomingEvents = allEvents
  .filter((event: any) => new Date(event.dateOfEvent) >= now)
  .sort((a: any, b: any) => new Date(a.dateOfEvent).getTime() - new Date(b.dateOfEvent).getTime());

const pastEvents = allEvents
  .filter((event: any) => new Date(event.dateOfEvent) < now)
  .sort((a: any, b: any) => new Date(b.dateOfEvent).getTime() - new Date(a.dateOfEvent).getTime());

// One row: what's coming up first (soonest first), then what FINSOC has run
// (most recent first). Upcoming cards are marked, so the row needs no split.
const events = [
  ...upcomingEvents.map((event: any) => ({ ...event, upcoming: true })),
  ...pastEvents.map((event: any) => ({ ...event, upcoming: false })),
];

const formatDate = (d: string) =>
  new Date(d).toLocaleDateString('en-AU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Australia/Sydney' });
---

<section id="events" class="overflow-hidden pt-10 pb-6 md:pt-12 md:pb-6">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex items-end justify-between gap-6">
      <div>
        <h2 class="text-4xl font-black tracking-tight text-brand-primary md:text-5xl">EVENTS</h2>
        {upcomingEvents.length === 0 && pastEvents.length > 0 && (
          <p class="mt-3 text-sm font-bold text-brand-primary/70 md:text-base">Nothing scheduled right now. Recent events below.</p>
        )}
      </div>
      {events.length > 0 && (
        <div class="carousel-nav">
          <CarouselButton direction="prev" class="swiper-prev-events" label="Previous events" />
          <CarouselButton direction="next" class="swiper-next-events" label="Next events" />
        </div>
      )}
    </div>
  </div>

  {events.length > 0 ? (
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="swiper swiper-events">
        <div class="swiper-wrapper py-6">
          {events.map((event: any) => (
            <div class="swiper-slide h-auto">
              <a
                href={event.fbEventLink || "#events"}
                target={event.fbEventLink ? "_blank" : undefined}
                rel={event.fbEventLink ? "noopener noreferrer" : undefined}
                class="event-card group block h-full"
              >
                <div class="event-frame relative mb-5 aspect-[4/3] overflow-hidden rounded-[0.5rem] bg-brand-primary shadow-sm transition-shadow duration-500 group-hover:shadow-xl">
                  {event.coverPhoto && (
                    <Image
                      src={urlFor(event.coverPhoto).width(1000).url()}
                      alt={event.name}
                      width={1000}
                      height={750}
                      class="h-full w-full object-cover transition-transform duration-700 ease-[cubic-bezier(0.16,1,0.3,1)] group-hover:scale-105"
                    />
                  )}

                  <div class="absolute top-5 left-5 z-20">
                    <span class="rounded-[0.5rem] border border-white/20 bg-brand-primary/70 px-3.5 py-1.5 text-[11px] font-black uppercase tracking-[0.2em] text-brand-secondary backdrop-blur-md">
                      {event.category}
                    </span>
                  </div>
                </div>

                <div class="px-1">
                  <p class="mb-2.5 flex items-center gap-3 text-[11px] font-black uppercase tracking-[0.25em] text-steel">
                    {event.upcoming && <span class="rounded-[0.5rem] bg-brand-accent px-2 py-0.5 tracking-[0.15em] text-brand-primary">Upcoming</span>}
                    <time datetime={event.dateOfEvent}>{formatDate(event.dateOfEvent)}</time>
                  </p>
                  <h3 class="mb-4 line-clamp-2 text-xl leading-tight font-black text-brand-primary transition-colors group-hover:text-steel md:text-2xl">
                    {event.name}
                  </h3>

                  {event.fbEventLink && (
                    <span class="inline-flex items-center gap-2.5 text-[11px] font-black uppercase tracking-[0.25em] text-brand-primary/60 transition-colors group-hover:text-brand-primary">
                      VIEW ON FACEBOOK
                      <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"><path d="M7 17 17 7"/><path d="M7 7h10v10"/></svg>
                    </span>
                  )}
                </div>
              </a>
            </div>
          ))}
        </div>
      </div>
      <!-- Outside .swiper so its overflow clipping can't cut the dots off -->
      <div class="events-dots swiper-pagination-events"></div>
    </div>
  ) : (
    <div class="mx-auto mt-8 max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-[0.5rem] border-2 border-dashed border-steel/30 py-16 text-center">
        <p class="text-sm font-bold uppercase tracking-widest text-steel">No events to display</p>
      </div>
    </div>
  )}
</section>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  if (document.querySelector('.swiper-events')) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    new Swiper('.swiper-events', {
      modules: [Navigation, Pagination, Autoplay],
      slidesPerView: 1.08,
      spaceBetween: 20,
      autoplay: reduceMotion ? false : { delay: 6000, disableOnInteraction: true, pauseOnMouseEnter: true },
      pagination: { el: '.swiper-pagination-events', clickable: true },
      navigation: { prevEl: '.swiper-prev-events', nextEl: '.swiper-next-events' },
      breakpoints: {
        768: { slidesPerView: 2, spaceBetween: 24 },
        1280: { slidesPerView: 3, spaceBetween: 28 },
      },
    });
  }
</script>

<style>
  /* Photo frames give way on short screens, so the whole events sheet,
     sponsor strip included, always fits one screen and pins flush */
  .event-frame {
    max-height: max(8rem, calc(100svh - 30rem));
  }

  /* Short screens: tighter rhythm so the sheet still fits */
  @media (max-height: 800px) {
    #events {
      padding-top: 1.75rem;
    }

    #events :global(.swiper-wrapper) {
      padding-block: 1rem;
    }
  }

  .event-card:focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 4px;
    border-radius: 0.5rem;
  }

  .events-dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.625rem;
    min-height: 1.5rem;
    margin-top: 0.25rem;
  }

  .events-dots :global(.swiper-pagination-bullet) {
    position: relative;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 9999px;
    background: rgb(10 25 47 / 0.18);
    cursor: pointer;
    transition: background-color 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  /* Larger invisible hit area for fingers */
  .events-dots :global(.swiper-pagination-bullet)::before {
    content: '';
    position: absolute;
    inset: -0.5rem -0.3rem;
  }

  .events-dots :global(.swiper-pagination-bullet:hover) {
    background: rgb(10 25 47 / 0.4);
  }

  .events-dots :global(.swiper-pagination-bullet-active),
  .events-dots :global(.swiper-pagination-bullet-active:hover) {
    width: 1.75rem;
    background: var(--color-brand-primary);
  }

  .events-dots :global(.swiper-pagination-bullet:focus-visible) {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }

  .events-dots:global(.swiper-pagination-lock) {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .events-dots :global(.swiper-pagination-bullet) {
      transition: none;
    }
  }
</style>
