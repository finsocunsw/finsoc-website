---
/**
 * The handover between two home page sections, drawn as a print halftone.
 * The next section's colour rises as a staggered screen of dots: pinpricks
 * at the top that swell row by row until they touch, while the paper beneath
 * the last rows takes on the new colour, so the band lands seamlessly on the
 * section below.
 *
 * Dots are vector circles at fixed pixel sizes, so they stay perfectly crisp
 * at every width and pixel density. Where scroll-driven animation is
 * supported the dots swell as the band scrolls into view; everywhere else,
 * and with reduced motion, the finished screen is shown.
 */
interface Props {
  /** Colour of the section above */
  from: string;
  /** Colour of the section below */
  to: string;
  /** Number of rows in the screen: more rows, a longer dissolve */
  rows?: number;
}

const { from, to, rows = 12 } = Astro.props;

const CELL = 12; // px between dot centres
// Dots grow until they just kiss their neighbours. They never reach the
// edge of their pattern tile, so no tile seam can ever render.
const R_MAX = CELL * 0.49;
const id = `ht-${Math.random().toString(36).slice(2, 9)}`;

const screen = Array.from({ length: rows }, (_, i) => {
  const t = rows === 1 ? 1 : i / (rows - 1);
  const e = t * t * (3 - 2 * t);
  return {
    id: `${id}-${i}`,
    t: Number(t.toFixed(4)),
    r: Number((R_MAX * e).toFixed(3)),
    x: i % 2 ? CELL / 2 : 0,
    y: i * CELL,
  };
});
---

<div class="halftone" style={`--ht-from: ${from}; --ht-to: ${to}; height: ${rows * CELL}px;`} aria-hidden="true">
  <svg width="100%" height={rows * CELL} focusable="false" style={`--r-max: ${R_MAX}px;`}>
    <defs>
      {screen.map((row) => (
        <pattern id={row.id} x={row.x} y={row.y} width={CELL} height={CELL} patternUnits="userSpaceOnUse">
          <circle class="halftone-dot" cx={CELL / 2} cy={CELL / 2} r={row.r} style={`--t: ${row.t};`} />
        </pattern>
      ))}
    </defs>
    {screen.map((row) => (
      <rect x="0" y={row.y} width="100%" height={CELL} fill={`url(#${row.id})`} />
    ))}
  </svg>
</div>

<style>
  @property --grow {
    syntax: '<number>';
    inherits: true;
    initial-value: 1;
  }

  .halftone {
    position: relative;
    margin-block: -1px; /* no sub-pixel hairline against either section */
    overflow: hidden;
    /* The final merge happens in the paper: beneath the last rows of touching
       dots it takes on the next colour, so the gaps fill in like spreading ink */
    background: linear-gradient(to bottom, var(--ht-from) 62%, var(--ht-to) 100%);
  }

  .halftone svg {
    display: block;
    /* How far the dissolve has climbed: at 0 only the bottom rows hold dots */
    --lag: calc((1 - var(--grow)) * 0.85);
  }

  .halftone-dot {
    fill: var(--ht-to);
  }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .halftone svg {
        animation: halftone-grow linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 55%;
      }

      /* Each row swells once the front reaches it; the last row is always
         solid, so the band never shows an edge against the next section */
      .halftone-dot {
        --x: clamp(0, (var(--t) - var(--lag)) / (1 - var(--lag)), 1);
        r: calc(var(--r-max) * var(--x) * var(--x) * (3 - 2 * var(--x)));
      }
    }
  }

  @keyframes halftone-grow {
    from {
      --grow: 0;
    }
    to {
      --grow: 1;
    }
  }
</style>
