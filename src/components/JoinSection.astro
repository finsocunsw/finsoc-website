<!-- The navy finale: runs straight on into the footer below -->
<section id="join" class="bg-brand-primary pt-8 pb-16 text-brand-secondary md:pt-12 md:pb-24">
  <div class="mx-auto flex max-w-7xl flex-col gap-10 px-4 sm:px-6 md:flex-row md:items-end md:justify-between lg:px-8">
    <h2 class="max-w-3xl text-4xl font-black leading-[0.95] tracking-[-0.03em] text-balance sm:text-5xl md:text-6xl lg:text-7xl">
      WANT TO STAY UP TO DATE ON <span class="text-steel-light">OUR EVENTS?</span>
    </h2>

    <a href="https://campus.hellorubric.com/?tab=memberships&s=12537" class="join-btn">
      JOIN US ON RUBRIC
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
    </a>
  </div>
</section>

<style>
  .join-btn {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    min-height: 3.75rem;
    padding: 0 2.25rem;
    border-radius: 0.5rem;
    background: var(--color-brand-accent);
    color: var(--color-brand-primary);
    font-size: 1rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    white-space: nowrap;
    transition: background-color 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .join-btn svg {
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .join-btn:hover {
    background: var(--color-brand-secondary);
    transform: translateY(-2px);
  }

  .join-btn:hover svg {
    transform: translateX(3px);
  }

  .join-btn:active {
    transform: translateY(0);
  }

  .join-btn:focus-visible {
    outline: 2px solid var(--color-brand-accent);
    outline-offset: 3px;
  }

  @media (max-width: 639px) {
    .join-btn {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .join-btn,
    .join-btn svg,
    .join-btn:hover,
    .join-btn:hover svg {
      transition: none;
      transform: none;
    }
  }
</style>
