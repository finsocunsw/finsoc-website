---
import { Image } from 'astro:assets';
import { urlFor } from '../utils/sanity';
import CarouselButton from './CarouselButton.astro';

interface Props {
  slides: any[];
  title: string;
  /** Lets a section header render the arrows instead (see index.astro) */
  id?: string;
  /** Render the arrows beside the progress bar */
  controls?: boolean;
  /** feature: pages as large as the screen allows, side by side, all at
      full strength, each one opening the issue (the home page's Review sheet) */
  size?: 'default' | 'feature';
  /** feature: where a page leads when clicked */
  href?: string;
}

const { slides, title, id = 'publication-slideshow', controls = true, size = 'default', href } = Astro.props;
const feature = size === 'feature';
const slideClass = feature
  ? 'slide slide-feature flex-none snap-start'
  : 'slide flex-none snap-center transition-all duration-700 ease-out scale-[0.9] opacity-40 [&.active]:scale-[1.0] [&.active]:opacity-100 w-[85%] md:w-[60%] lg:w-[45%] first:ml-[7.5%] md:first:ml-[20%] lg:first:ml-[27.5%] last:mr-[7.5%] md:last:mr-[20%] lg:last:mr-[27.5%]';
const PageWrap = feature && href ? 'a' : 'div';
---

<div class:list={['publication-slideshow group relative', feature && 'is-feature']} data-slideshow={id}>
  <div
    class:list={['slides-container flex overflow-x-auto snap-x snap-mandatory scrollbar-hide', feature ? 'pt-2 pb-6' : 'gap-6 px-2 py-4']}
    data-slideshow-track
  >
    {slides.map((slide, index) => (
      <div class={slideClass}>
        <PageWrap
          href={PageWrap === 'a' ? href : undefined}
          aria-label={PageWrap === 'a' ? `Read ${title}, page ${index + 1}` : undefined}
          class:list={['page bg-white rounded-sm overflow-hidden group/card relative block', !feature && 'shadow-2xl border border-afr-border']}
        >
          <Image 
            src={urlFor(slide).width(1080).height(1350).fit('crop').url()} 
            alt={slide.alt || `${title} - Slide ${index + 1}`}
            width={1080}
            height={1350}
            class="w-full h-full object-cover aspect-[4/5] transition-transform duration-700 group-hover/card:scale-[1.02]"
          />
          <div class="absolute inset-0 bg-afr-black/0 group-hover/card:bg-afr-black/5 transition-colors duration-500"></div>
        </PageWrap>
      </div>
    ))}
  </div>
  
  <div class:list={['mx-auto flex max-w-md items-center gap-5 px-4 font-sans', feature ? 'mt-5' : 'mt-12']}>
    {(controls || feature) && <CarouselButton direction="prev" label="Previous page" data-carousel={id} data-dir="prev" class={!controls ? 'sm:hidden' : undefined} />}
    <div class="progress-bar-container flex-1">
      <div class="h-0.5 bg-afr-border rounded-full overflow-hidden">
        <div
          data-slideshow-progress
          class="h-full bg-(--slideshow-accent,var(--color-afr-red)) transition-all duration-500" 
          style="width: 0%"
        ></div>
      </div>
      <div class="flex justify-between mt-4 text-[11px] font-black tracking-[0.25em] text-(--slideshow-meta,rgb(17_17_17_/_0.6)) uppercase">
        <span><span class:list={['counter-word', feature && 'max-sm:hidden']}>SECTION </span><span data-slideshow-current>01</span></span>
        <span><span class:list={['counter-word', feature && 'max-sm:hidden']}>SECTION </span>{slides.length.toString().padStart(2, '0')}</span>
      </div>
    </div>
    {(controls || feature) && <CarouselButton direction="next" label="Next page" data-carousel={id} data-dir="next" class={!controls ? 'sm:hidden' : undefined} />}
  </div>
</div>

<style>
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .slides-container {
    scroll-behavior: smooth;
    scroll-padding: 0 10%;
  }

  /* Feature size: a whole number of pages always fills the row, so no page
     is ever cut at the edge. --n pages fit side by side (one on phones, an
     open two-page spread on wide screens, set by the parent); each is as
     large as both the row and the screen height allow. */
  .is-feature {
    container-type: inline-size;
  }

  .is-feature .slides-container {
    --n: var(--spread, 1);
    --gap: var(--spread-gap, 1rem);
    --page: min(var(--page-cap, calc((100svh - 19rem) * 0.8)), calc((100cqw - var(--gap) * (var(--n) - 1)) / var(--n)), 36rem);

    width: calc(var(--page) * var(--n) + var(--gap) * (var(--n) - 1));
    gap: var(--gap);
    scroll-padding: 0;
  }

  .slide-feature {
    width: var(--page);
  }

  /* A soft lift rather than a heavy drop shadow; the row's bottom padding
     leaves it room, so the track never clips it into a band */
  .slide-feature .page {
    border: 1px solid rgb(10 25 47 / 0.08);
    box-shadow:
      0 1px 2px rgb(10 25 47 / 0.06),
      0 14px 28px -20px rgb(10 25 47 / 0.4);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .slide-feature a.page:hover {
    transform: translateY(-4px);
  }

  .slide-feature a.page:focus-visible {
    outline: 2px solid var(--slideshow-accent, var(--color-brand-primary));
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .slide-feature .page,
    .slide-feature a.page:hover {
      transition: none;
      transform: none;
    }
  }
</style>

<script is:inline define:vars={{ slideshowId: id }}>
  (function () {
    const root = document.querySelector(`[data-slideshow="${slideshowId}"]`);
    const container = root?.querySelector('[data-slideshow-track]');
    const progressBar = root?.querySelector('[data-slideshow-progress]');
    const currentPageText = root?.querySelector('[data-slideshow-current]');
    const slides = container?.querySelectorAll('.slide');
    if (!root || !container || !progressBar || !slides?.length) return;

    // Arrows can live inside the slideshow or in a section header elsewhere
    const prevBtns = document.querySelectorAll(`[data-carousel="${slideshowId}"][data-dir="prev"]`);
    const nextBtns = document.querySelectorAll(`[data-carousel="${slideshowId}"][data-dir="next"]`);

    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        entry.target.classList.toggle('active', entry.isIntersecting);
      });
      // When several pages are in view, the counter names the first of them
      const first = Array.from(slides).findIndex((slide) => slide.classList.contains('active'));
      if (currentPageText && first >= 0) {
        currentPageText.textContent = (first + 1).toString().padStart(2, '0');
      }
    }, { root: container, threshold: 0.6 });

    slides.forEach((slide) => observer.observe(slide));

    const update = () => {
      const maxScroll = container.scrollWidth - container.clientWidth;
      const progress = maxScroll > 0 ? (container.scrollLeft / maxScroll) * 100 : 100;
      progressBar.style.width = `${Math.min(100, Math.max(0, progress))}%`;
      prevBtns.forEach((btn) => { btn.disabled = container.scrollLeft <= 2; });
      nextBtns.forEach((btn) => { btn.disabled = container.scrollLeft >= maxScroll - 2; });
    };

    const step = () =>
      slides[0] ? slides[0].clientWidth + (parseFloat(getComputedStyle(container).columnGap) || 24) : container.clientWidth * 0.5;

    prevBtns.forEach((btn) => btn.addEventListener('click', () => container.scrollBy({ left: -step(), behavior: 'smooth' })));
    nextBtns.forEach((btn) => btn.addEventListener('click', () => container.scrollBy({ left: step(), behavior: 'smooth' })));

    container.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update, { passive: true });
    update();
  })();
</script>
