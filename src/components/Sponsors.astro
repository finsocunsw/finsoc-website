---
import { getSponsors } from '../utils/sanity';
import { getLogoFrame, logoUrl } from '../utils/logoBox';

/*
  The partner drum that closes the home page: every sponsor on a white plate
  around a slowly turning cylinder. The plate facing you is in full colour
  with its name beneath; the rest fade to grey as they turn away. Plates
  rather than bare logos, because CMS logos arrive in any form, some on solid
  white grounds.
*/
const sponsors: any[] = await getSponsors();

// Highest tier first; no tier titles on the home page
const tierOrder = ['platinum', 'gold', 'silver', 'bronze'];
const rank = (tier: string) => {
  const at = tierOrder.indexOf(tier);
  return at < 0 ? tierOrder.length : at;
};

const logos = (
  await Promise.all(
    sponsors.map(async (sponsor) => {
      if (!sponsor.logo?.asset) return { name: sponsor.name, tier: sponsor.sponsorTier, src: null };
      const frame = await getLogoFrame(sponsor.logo);
      // Size every logo to the same visual area: wide wordmarks sit lower,
      // stacked marks stand taller. --k scales a shared base height.
      const k = 1 / Math.sqrt(frame.ratio);
      return {
        name: sponsor.name,
        tier: sponsor.sponsorTier,
        src: logoUrl(sponsor.logo, frame, 96),
        src2x: logoUrl(sponsor.logo, frame, 192),
        ratio: frame.ratio,
        k: Math.round(k * 1000) / 1000,
      };
    }),
  )
).sort((a, b) => rank(a.tier) - rank(b.tier));

// A drum needs at least six faces to read as a cylinder; with fewer partners
// the logos repeat around it (the repeats are hidden from screen readers)
const slots = logos.length ? Math.max(logos.length, 6) : 0;
const faces = Array.from({ length: slots }, (_, i) => ({ ...logos[i % logos.length], repeat: i >= logos.length }));
---

<section id="sponsors" class="partners" aria-labelledby="sponsors-title">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <h2 id="sponsors-title" class="text-center text-4xl font-black tracking-tight text-balance text-brand-primary md:text-5xl">
      SUPPORTED BY INDUSTRY LEADERS
    </h2>
  </div>

  {faces.length > 0 && (
    <div class="drum-wrap">
      <div
        class="drum-stage"
        data-drum
        tabindex="0"
        role="region"
        aria-roledescription="carousel"
        aria-label="Partner logos. Drag, swipe or use the left and right arrow keys to turn."
      >
        <ul class="drum" role="list" style={`--n: ${faces.length}`} data-drum-ring>
          {faces.map((face, i) => (
            <li class="drum-face" style={`--i: ${i}`} aria-hidden={face.repeat ? 'true' : undefined} data-name={face.name}>
              {face.src ? (
                <img
                  src={face.src}
                  srcset={`${face.src} 1x, ${face.src2x} 2x`}
                  alt={face.repeat ? '' : face.name}
                  width={Math.round(96 * face.ratio)}
                  height={96}
                  loading="lazy"
                  decoding="async"
                  draggable="false"
                  class="drum-logo"
                  style={`--k: ${face.k}`}
                />
              ) : (
                <span class="drum-text">{face.name}</span>
              )}
            </li>
          ))}
        </ul>
      </div>
      <p class="drum-caption" aria-hidden="true" data-drum-caption>{faces[0].name}</p>
    </div>
  )}

  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="partner-links">
      <a href="/affiliations" class="section-link">VIEW ALL AFFILIATIONS</a>
      <a href="mailto:sponsorships@unswfinsoc.org" class="section-link">PARTNER WITH US</a>
    </div>
  </div>
</section>

<script>
  const stage = document.querySelector<HTMLElement>('[data-drum]');
  const ring = stage?.querySelector<HTMLElement>('[data-drum-ring]');
  const caption = document.querySelector<HTMLElement>('[data-drum-caption]');

  if (stage && ring) {
    const faces = Array.from(ring.querySelectorAll<HTMLElement>('.drum-face'));
    const n = faces.length;
    const step = 360 / n;
    const still = window.matchMedia('(prefers-reduced-motion: reduce)');

    const SPIN = 360 / 48; // one slow turn every 48 seconds, in degrees per second
    let angle = 0; // degrees; a face is in front when angle = -i * step
    let target: number | null = null; // where the drum is easing to, if anywhere
    let inView = false;
    let held = false; // hover or focus holds it still on a partner
    let dragging = false;
    // Once the visitor touches it in any way, it stays still for the rest of
    // the visit: the drum is theirs to turn from then on
    let stopped = false;
    let running = false;
    let last = performance.now();

    const nearest = (a: number) => Math.round(a / step) * step;
    const frontIndex = () => (((Math.round(-angle / step) % n) + n) % n);

    // Faces turning away fade to grey and recede; the front one is in colour
    const paint = () => {
      ring.style.transform = `translateZ(calc(var(--r) * -1)) rotateY(${angle}deg)`;
      faces.forEach((face, i) => {
        const facing = Math.max(0, Math.cos(((i * step + angle) * Math.PI) / 180));
        face.style.opacity = String(0.25 + 0.75 * facing ** 1.5);
        face.style.setProperty('--grey', String(1 - facing ** 3));
      });
      if (caption) caption.textContent = faces[frontIndex()].dataset.name ?? '';
    };

    const turning = () => inView && !held && !stopped && !still.matches && !document.hidden;

    // The loop runs only while there is something to animate: an ease to a
    // partner, a drag, or the slow turn while on screen and untouched
    const frame = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000);
      last = now;
      if (!dragging) {
        if (target !== null) {
          // Ease to the chosen partner
          angle += (target - angle) * (1 - Math.exp(-dt * 9));
          if (Math.abs(target - angle) < 0.05) {
            angle = target;
            target = null;
          }
        } else if (turning()) {
          angle -= SPIN * dt;
        }
      }
      paint();
      if (dragging || target !== null || turning()) requestAnimationFrame(frame);
      else running = false;
    };

    const kick = () => {
      if (running) return;
      running = true;
      last = performance.now();
      requestAnimationFrame(frame);
    };

    const takeOver = () => {
      stopped = true;
    };

    const settle = (to = nearest(angle)) => {
      target = to;
      if (still.matches) {
        angle = to;
        target = null;
        paint();
      }
      kick();
    };

    // Hover and keyboard focus hold the drum on a partner
    stage.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'mouse') {
        held = true;
        takeOver();
        settle();
      }
    });
    stage.addEventListener('pointerleave', (e) => {
      if (e.pointerType === 'mouse') held = false;
    });
    stage.addEventListener('focus', () => {
      held = true;
      takeOver();
      settle();
    });
    stage.addEventListener('blur', () => {
      held = false;
    });

    // Drag or swipe to spin it; letting go settles on the nearest partner
    let startX = 0;
    let startAngle = 0;
    stage.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'mouse' && e.button !== 0) return;
      dragging = true;
      takeOver();
      kick();
      startX = e.clientX;
      startAngle = angle;
      target = null;
      stage.setPointerCapture(e.pointerId);
      stage.dataset.dragging = '';
    });
    stage.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const dx = e.clientX - startX;
      // A drag across the face width turns the drum by about one partner
      angle = startAngle + (dx / ring.offsetWidth) * step;
    });
    const release = () => {
      if (!dragging) return;
      dragging = false;
      delete stage.dataset.dragging;
      settle();
    };
    stage.addEventListener('pointerup', release);
    stage.addEventListener('pointercancel', release);

    // Arrow keys turn one partner at a time
    stage.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      takeOver();
      const from = target ?? nearest(angle);
      settle(from + (e.key === 'ArrowLeft' ? step : -step));
    });

    new IntersectionObserver(([entry]) => {
      inView = entry.isIntersecting;
      if (inView) kick();
    }).observe(stage);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) kick();
    });

    stage.classList.add('is-live');
    paint();
  }
</script>

<style>
  .partners {
    padding-block: 3rem 2rem;
  }

  /* ---------- The drum ---------- */

  .drum-wrap {
    --face-w: 11.5rem;
    --face-h: 6rem;
    --logo-base: 2.5rem;
    /* Radius that puts the faces edge to edge around the drum, with a hair of air */
    --r: calc(var(--face-w) / 2 / tan(calc(180deg / var(--n, 6))) * 1.08);

    margin-top: 1.5rem;
    overflow: hidden;
  }

  .drum-stage {
    position: relative;
    display: flex;
    justify-content: center;
    height: calc(var(--face-h) + 3rem);
    padding-top: 1.5rem;
    perspective: 1500px;
    perspective-origin: 50% 40%;
    touch-action: pan-y;
    cursor: grab;
    user-select: none;
  }

  .drum-stage[data-dragging] {
    cursor: grabbing;
  }

  .drum-stage:focus-visible {
    outline: none;
  }

  .drum-stage:focus-visible .drum-face {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 4px;
  }

  .drum {
    --n: 6;

    position: relative;
    width: var(--face-w);
    height: var(--face-h);
    margin: 0;
    padding: 0;
    list-style: none;
    transform-style: preserve-3d;
    transform: translateZ(calc(var(--r) * -1));
  }

  .drum-face {
    --grey: 0;

    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    background: var(--color-brand-secondary);
    box-shadow:
      0 1px 2px rgb(10 25 47 / 0.06),
      0 16px 32px -22px rgb(10 25 47 / 0.45);
    transform: rotateY(calc(var(--i) * 360deg / var(--n))) translateZ(var(--r));
    backface-visibility: hidden;
  }

  .drum-logo {
    display: block;
    width: auto;
    max-width: 100%;
    height: max(0.875rem, calc(var(--logo-base) * var(--k, 0.7)));
    max-height: calc(var(--logo-base) * 1.3);
    object-fit: contain;
    filter: grayscale(var(--grey));
    pointer-events: none;
  }

  .drum-text {
    font-size: 1rem;
    font-weight: 700;
    text-align: center;
    color: var(--color-brand-primary);
  }

  /* The partner facing you, named beneath the drum */
  .drum-caption {
    margin: 0.75rem 0 0;
    min-height: 1.5em;
    font-size: 0.6875rem;
    font-weight: 900;
    letter-spacing: 0.25em;
    text-align: center;
    text-transform: uppercase;
    color: var(--color-steel);
  }

  /* ---------- Links ---------- */

  .partner-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem 2rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 768px) {
    .partners {
      padding-block: 4rem 2.5rem;
    }

    .drum-wrap {
      --face-w: 20rem;
      --face-h: 10rem;
      --logo-base: 4.5rem;

      margin-top: 2rem;
    }
  }
</style>
