---
import Layout from '../layouts/Layout.astro';
import { getSponsors } from '../utils/sanity';
import { partnerLogo } from '../utils/logos';

interface Sponsor {
  _id: string;
  name: string;
  sponsorTier?: string;
  logo?: { asset?: { _ref?: string } };
}

// Highest tier first; a partner without a known tier goes last under "Partners"
const TIERS = [
  { key: 'platinum', name: 'Platinum' },
  { key: 'gold', name: 'Gold' },
  { key: 'silver', name: 'Silver' },
  { key: 'bronze', name: 'Bronze' },
];

const sponsors = (await getSponsors()) as Sponsor[];

// Each logo cropped to its drawn mark; sqrt(ratio) gives every logo the same
// area, and each tier then sets how large that area is
const withLogos = await Promise.all(
  sponsors.map(async (sponsor) => {
    const image = await partnerLogo(sponsor.logo);
    return { ...sponsor, image, root: image ? Math.sqrt(image.width / image.height) : 1 };
  }),
);

const known = new Set(TIERS.map((t) => t.key));
const tiers = [...TIERS, { key: 'other', name: 'Partners' }]
  .map((tier, step) => ({
    ...tier,
    step,
    partners: withLogos
      .filter((p) => (tier.key === 'other' ? !known.has(p.sponsorTier ?? '') : p.sponsorTier === tier.key))
      .sort((a, b) => a.name.localeCompare(b.name)),
  }))
  .filter((tier) => tier.partners.length > 0)
  // Shown tiers step down in size from the top, whichever tiers exist
  .map((tier, index) => ({ ...tier, scale: Math.max(0.6, 1 - index * 0.2) }));

const sponsorshipsEmail = 'sponsorships@unswfinsoc.org';
---

<Layout title="Affiliations | UNSW FINSOC" navTone="navy" pageClass="bg-brand-primary" mainClass="bg-brand-primary">
  <!-- A mist sheet tucked under the navy bar, as the home page closes. The
       partners sit straight on it, one tier to a row, each tier's logos a
       step smaller than the one above. -->
  <section class="partners" aria-labelledby="partners-title">
    <div class="partners-column">
      <h1 class="partners-title" id="partners-title">Our partners</h1>

      {tiers.length > 0 ? (
        <div class="tiers">
          {tiers.map((tier) => (
            <section class="tier" aria-labelledby={`tier-${tier.key}`} style={`--scale: ${tier.scale}`}>
              <h2 class="tier-name" id={`tier-${tier.key}`}>{tier.name}</h2>
              <ul class="tier-logos" role="list">
                {tier.partners.map((partner) => (
                  <li class="tier-logo">
                    {partner.image ? (
                      <img
                        src={partner.image.src}
                        srcset={partner.image.srcset}
                        sizes="(min-width: 1024px) 16rem, 40vw"
                        width={partner.image.width}
                        height={partner.image.height}
                        alt={partner.name}
                        style={`--root: ${partner.root.toFixed(3)}`}
                        loading="eager"
                        decoding="async"
                      />
                    ) : (
                      <span class="tier-logo-name">{partner.name}</span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      ) : (
        <p class="partners-empty">Our partners for this year are being finalised.</p>
      )}

      <div class="partners-ask">
        <p class="partners-line">Interested in partnering with FINSOC? Email our sponsorships team.</p>
        <a class="partners-button" href={`mailto:${sponsorshipsEmail}`}>
          Email sponsorships
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 6.75A1.75 1.75 0 0 1 4.75 5h14.5A1.75 1.75 0 0 1 21 6.75v10.5A1.75 1.75 0 0 1 19.25 19H4.75A1.75 1.75 0 0 1 3 17.25V6.75Z" />
            <path d="m3.5 6.5 8.5 6.25 8.5-6.25" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .partners {
    --ease: cubic-bezier(0.16, 1, 0.3, 1);
    --pad: 1rem;
    /* The area every logo gets in the top tier: a square of this side */
    --unit: 5.5rem;
    --rule: rgb(10 25 47 / 0.12);

    min-height: calc(100svh - 5rem);
    padding: clamp(2rem, 5svh, 3.5rem) var(--pad) clamp(3.5rem, 8svh, 6rem);
    border-radius: 0.5rem 0.5rem 0 0;
    background: var(--color-mist);
    color: var(--color-brand-primary);
  }

  .partners :global(::selection) {
    background: var(--color-brand-accent);
    color: var(--color-brand-primary);
  }

  .partners :focus-visible {
    outline: 2px solid var(--color-brand-primary);
    outline-offset: 3px;
  }

  @media (min-width: 640px) {
    .partners {
      --pad: 1.5rem;
      --unit: 6.5rem;
    }
  }

  @media (min-width: 1024px) {
    .partners {
      --pad: 2rem;
      /* Grows with the screen's height so the tiers keep to the first screen */
      --unit: clamp(6.5rem, 14svh, 10rem);
    }
  }

  .partners-column {
    max-width: calc(80rem - 2 * var(--pad));
    margin-inline: auto;
  }

  .partners-title {
    margin-bottom: clamp(1.5rem, 4svh, 2.5rem);
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 900;
    line-height: 0.92;
    letter-spacing: -0.04em;
    text-transform: uppercase;
    text-wrap: balance;
  }

  /* ---------- Tiers: one row each, the name on the left, logos across ---------- */

  .tier {
    display: grid;
    gap: 1.25rem 2rem;
    padding-block: clamp(1.25rem, 3svh, 2rem);
    border-top: 1px solid var(--rule);
  }

  @media (min-width: 768px) {
    .tier {
      grid-template-columns: 10rem minmax(0, 1fr);
      align-items: center;
    }
  }

  .tier-name {
    font-size: 1.125rem;
    font-weight: 900;
    line-height: 1.25;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .tier-logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: calc(var(--unit) * var(--scale) * 0.5) calc(var(--unit) * var(--scale) * 0.75);
  }

  .tier-logo {
    display: flex;
    flex: none;
    align-items: center;
    max-width: 100%;
  }

  /* Equal area within a tier: width = side x sqrt(ratio), so height = side /
     sqrt(ratio). A very long wordmark stops at 2.2 sides wide. */
  .tier-logo img {
    width: calc(var(--unit) * var(--scale) * min(var(--root), 2.2));
    max-width: 100%;
    height: auto;
    /* White-ground logo files drop their ground and sit straight on the mist */
    mix-blend-mode: multiply;
  }

  .tier-logo-name {
    font-size: calc(1.5rem * var(--scale));
    font-weight: 900;
    line-height: 1.15;
    text-transform: uppercase;
  }

  .partners-empty {
    padding: 4rem 1.5rem;
    border: 2px dashed rgb(85 117 144 / 0.3);
    border-radius: 0.5rem;
    color: var(--color-steel);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-align: center;
    text-transform: uppercase;
  }

  /* ---------- The ask: under the last tier's rule ---------- */

  .partners-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
    padding-top: clamp(1.25rem, 3svh, 2rem);
    border-top: 1px solid var(--rule);
  }

  .partners-line {
    max-width: 24rem;
    color: rgb(10 25 47 / 0.8);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.55;
    text-wrap: pretty;
  }

  @media (min-width: 768px) {
    .partners-ask {
      display: grid;
      grid-template-columns: 10rem auto auto;
      justify-content: start;
      column-gap: 2rem;
    }

    /* The line starts where the logos do */
    .partners-line {
      grid-column: 2;
      max-width: none;
    }
  }

  .partners-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0 2rem;
    border-radius: 0.5rem;
    background: var(--color-brand-primary);
    color: var(--color-brand-secondary);
    font-size: 0.875rem;
    font-weight: 900;
    letter-spacing: 0.06em;
    white-space: nowrap;
    text-decoration: none;
    text-transform: uppercase;
    transition:
      background-color 0.3s var(--ease),
      color 0.3s var(--ease);
  }

  .partners-button svg {
    width: 1.25rem;
    height: 1.25rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .partners-button:hover {
    background: var(--color-brand-accent);
    color: var(--color-brand-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .partners-button {
      transition: none;
    }
  }
</style>
